+	void Log::SetFileRotation (std::uint64_t maxFileSize, std::uint16_t maxLogFiles)
+	{
+		m_MaxFileSize = maxFileSize;
+		m_MaxLogFiles = maxLogFiles;
+	}
+
+	static bool FileExists (const std::string& path)
+	{
+		std::ifstream file (path, std::ios::binary);
+		return file.good ();
+	}
+
+	static bool RemoveIfExists (const std::string& path)
+	{
+		if (!FileExists (path)) return true;
+		return !std::remove (path.c_str ());
+	}
+
+	bool Log::ArchiveOversizedLog (const std::string& archive)
+	{
+		const auto temporary = m_Logfile + ".rotation-tmp";
+		const auto fallback = m_Logfile + ".rotation-full";
+		if (!RemoveIfExists (temporary) || !RemoveIfExists (fallback)) return false;
+
+		std::ifstream input (m_Logfile, std::ios::binary);
+		if (!input) return false;
+		input.seekg (0, std::ios::end);
+		auto length = input.tellg ();
+		if (length < 0) return false;
+		auto keep = static_cast<std::uint64_t>(length);
+		if (keep > m_MaxFileSize) keep = m_MaxFileSize;
+		input.seekg (length - static_cast<std::streamoff>(keep), std::ios::beg);
+		std::vector<char> tail (static_cast<std::size_t>(keep));
+		input.read (tail.data (), static_cast<std::streamsize>(tail.size ()));
+		if (static_cast<std::size_t>(input.gcount ()) != tail.size ()) return false;
+		input.close ();
+
+		std::ofstream output (temporary, std::ios::binary | std::ios::trunc);
+		if (!output) return false;
+		output.write (tail.data (), static_cast<std::streamsize>(tail.size ()));
+		output.close ();
+		if (!output) return false;
+
+		if (std::rename (m_Logfile.c_str (), fallback.c_str ())) return false;
+		if (std::rename (temporary.c_str (), archive.c_str ()))
+		{
+			std::rename (fallback.c_str (), m_Logfile.c_str ());
+			return false;
+		}
+		return RemoveIfExists (fallback);
+	}
+
+	bool Log::RotateLogFile ()
+	{
+		if (m_LogStream)
+		{
+			m_LogStream->flush ();
+			m_LogStream = nullptr;
+		}
+
+		bool rotated = true;
+		const auto oldest = m_Logfile + "." + std::to_string (m_MaxLogFiles);
+		rotated = RemoveIfExists (oldest);
+		for (std::uint16_t i = m_MaxLogFiles; rotated && i > 1; --i)
+		{
+			const auto source = m_Logfile + "." + std::to_string (i - 1);
+			const auto destination = m_Logfile + "." + std::to_string (i);
+			if (FileExists (source))
+			{
+				rotated = RemoveIfExists (destination) &&
+					!std::rename (source.c_str (), destination.c_str ());
+			}
+		}
+
+		const auto archive = m_Logfile + ".1";
+		if (rotated)
+		{
+			rotated = RemoveIfExists (archive);
+			if (rotated && FileExists (m_Logfile))
+			{
+				if (m_CurrentFileSize > m_MaxFileSize)
+					rotated = ArchiveOversizedLog (archive);
+				else
+					rotated = !std::rename (m_Logfile.c_str (), archive.c_str ());
+			}
+		}
+
+		SendTo (m_Logfile);
+		return rotated && m_LogStream;
+	}
+
+	void Log::RotateIfNeeded (std::size_t nextMessageSize)
+	{
+		if (!m_MaxFileSize || !m_MaxLogFiles || !m_CurrentFileSize) return;
+		if (m_CurrentFileSize < m_MaxFileSize &&
+			nextMessageSize <= m_MaxFileSize - m_CurrentFileSize) return;
+		if (!RotateLogFile ())
+		{
+			std::cerr << "Log: Failed to rotate " << m_Logfile
+				<< "; continuing without rotation" << std::endl;
+			m_MaxFileSize = 0;
+			m_MaxLogFiles = 0;
+		}
+	}
